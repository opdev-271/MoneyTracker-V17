<?xml version="1.0" encoding="utf-8"?>
<!-- The material laid over @id/glass_nav's real blur: a translucent pane, lit along its
     top edge, with a bright specular rim. Every color here is translucent on purpose -
     an opaque fill would hide the blur it is sitting on. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/surface_glass"
        android:startColor="@color/glass_sheen"
        android:type="linear" />
    <corners android:radius="@dimen/nav_pill_corner_radius" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
